# Local / Droplet secrets — DO NOT COMMIT
# Copy from .env.example and fill in values:
#   cp .env.example .env

SPRING_PROFILES_ACTIVE=prod
HOST_PORT=80
SERVER_PORT=8080

# Optional: image used by CI/CD deploy (set automatically by GitHub Actions)
# IMAGE=ghcr.io/aashishbudhuri/digitalocean-urlshortener:latest

# DigitalOcean Managed Postgres
DB_HOST=your-db-host.db.ondigitalocean.com
DB_PORT=25060
DB_NAME=defaultdb
DB_USERNAME=doadmin
DB_PASSWORD=replace-with-your-password
